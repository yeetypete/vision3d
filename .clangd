CompileFlags:
  CompilationDatabase: build
  # `build/compile_commands.json` is generated from the real nvcc build, so the
  # .cu entries carry driver flags clang does not accept. See .clang-tidy,
  # which drops the same set for the same reason.
  Remove:
    - --expt-relaxed-constexpr
    - --compiler-options
    - "'-fPIC'"
    - --cudart=static
    - -ccbin
    - gcc
    - -gencode=*

# libstdc++'s deduction guides aren't annotated __host__ __device__, which
# clang flags when parsing .cu files. Harmless in practice, so silence it.
Diagnostics:
  Suppress:
    - deduction_guide_target_attr

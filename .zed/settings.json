{
  "file_types": {
    "C++": ["cu", "cuh"]
  },
  "tab_size": 2,
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "inlay_hints": {
        "enabled": true
      },
      "language_servers": [
        "pyrefly",
        "!basedpyright",
        "!pylsp",
        "!pyright",
        "!ty",
        "..."
      ]
    }
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "arguments": ["lsp"],
        "path": ".venv/bin/pyrefly"
      }
    },
    "ruff": {
      "binary": {
        "arguments": ["server"],
        "path": ".venv/bin/ruff"
      }
    }
  }
}
